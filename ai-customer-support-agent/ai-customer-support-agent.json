      ],
      "webhookId": "696dcf7d-7ffd-4a29-acaf-65955821b726"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "approved",
              "leftValue": "={{ $json.data.approved }}",
              "rightValue": "",
