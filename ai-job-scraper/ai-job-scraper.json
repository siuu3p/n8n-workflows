    {
      "parameters": {
        "jsCode": "// Max jobs to tailor per Slack request (each one is an LLM call + a Google Doc).\nconst MAX_JOBS = 10;\n\nconst out = [];\nconst walk = (v) => {\n  if (Array.isArray(v)) return v.forEach(walk);\n  if (v && typeof v === 'object') {\n    if (v.job_title) return out.push(v);\n    if (Array.isArray(v.jobs)) return walk(v.jobs);\n    if (Array.isArray(v.data)) return walk(v.data);\n    // n8n turns an array into {\"0\": ..., \"1\": ...}\n    if (Object.keys(v).every((k) => /^\\d+$/.test(k))) return walk(Object.values(v));\n  }\n};\nfor (const item of $input.all()) walk(item.json.data);\n\nconst seen = new Set();\nconst jobs = [];\nfor (const j of out) {\n  const key = j.job_id || `${j.job_title}|${j.employer_name}`;\n  if (seen.has(key)) continue;\n  seen.add(key);\n  jobs.push({\n    job_id: j.job_id || null,\n    job_title: j.job_title,\n    employer_name: j.employer_name || 'Unknown company',\n    job_description: j.job_description || '',\n    apply_link: j.job_apply_link || (j.apply_options && j.apply_options[0] && j.apply_options[0].apply_link) || '',\n  });\n  if (jobs.length >= MAX_JOBS) break;\n}\nreturn [{ json: { count: jobs.length, jobs } }];"
      },
      "id": "8c4d2e6f-1a3b-4c5d-9e7f-0a1b2c3d4e5f",
